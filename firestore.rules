rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{id}  { allow read, write: if true; }
    match /chat/{id}   { allow read, write: if true; }
    match /packs/{id}  { allow read, write: if true; }
    match /cfg/{id}    { allow read, write: if true; }
  }
}
